<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TaskList</AssemblyName>
    <RootNamespace>TaskList</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.5.15</Version>
    <Product>TaskList</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <Target Name="GenerateWebVersion" BeforeTargets="Build">
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/wwwroot/version.js"
      Lines="window.TASKLIST_VERSION = '$(Version)';"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
</Project>
